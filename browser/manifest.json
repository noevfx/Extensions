{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.1.1",
  "minimum_chrome_version": "116",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://noevfx.com",
  "key": "",
  "permissions": [
    "contextMenus",
    "webRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Noe VFX Downloader for Editors",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["edition.js", "i18n.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
