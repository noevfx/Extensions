{
  "manifest_version": 3,
  "name": "NOÉ VFX Downloader",
  "version": "3.0.0",
  "description": "Detector universal de vídeos (HLS/DASH/MP4 + yt-dlp) na qualidade nativa do player — por NOÉ VFX (noevfx.com).",
  "homepage_url": "https://noevfx.com",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "webRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NOÉ VFX Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
